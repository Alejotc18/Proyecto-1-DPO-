  <diagram name="DIAGRAMA DE CLASES DE DISENO" id="0">
    <mxGraphModel dx="14033" dy="7400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2958" pageHeight="10564" math="0" shadow="0">
      <root>
        <mxCell id="0" />
