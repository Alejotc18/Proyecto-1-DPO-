        </mxCell>
        <mxCell id="leyenda" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=light-dark(#FFFDF5,#15120A);strokeColor=#C47F17;strokeWidth=2;fontSize=11.5;fontColor=light-dark(#111827,#E5E7EB);" value="&lt;div&gt;&lt;b style=&quot;font-size:14px&quot;&gt;COMO SE LEE&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(17, 24, 39), rgb(235, 235, 235));&quot;&gt;•&amp;nbsp; Flecha punteada de A hacia B significa que A usa clases de B&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(17, 24, 39), rgb(235, 235, 235));&quot;&gt;•&amp;nbsp; El numero dice cuantas clases de B se usan&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(17, 24, 39), rgb(235, 235, 235));&quot;&gt;•&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(229, 57, 53), rgb(255, 255, 255));&quot;&gt;Dos flechas rojas juntas&lt;b&gt;&amp;nbsp;&lt;/b&gt;es que&lt;/span&gt;&amp;nbsp;los dos paquetes se usan entre si hay seis pares y los seis están dentro del dominio.&lt;/div&gt;&lt;div&gt;•&amp;nbsp; Entre capas va una sola flecha y el texto dice que hace, en vez de una flecha por paquete&lt;/div&gt;&lt;div&gt;•&amp;nbsp; Las flechas entre capas siempre bajan&amp;nbsp;el dominio no usa nada de logica ni de persistencia&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="1600" x="50" y="1110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
