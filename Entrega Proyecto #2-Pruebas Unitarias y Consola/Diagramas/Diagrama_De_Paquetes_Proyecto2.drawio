        <mxCell id="q81" connectable="0" parent="q80" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=2;fontColor=#C47F17;labelBackgroundColor=light-dark(#FFFFFF,#141414);" value="lanza PersistenciaException" vertex="1">
